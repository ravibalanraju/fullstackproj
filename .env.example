# MongoDB Atlas connection string
# Atlas → Database → Connect → Drivers → copy the connection string,
# then replace <username> and <password> with your database user's credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# LLM provider credentials — any OpenAI-compatible API works.
# As submitted, this project uses Groq's free tier (https://console.groq.com):
OPENAI_API_KEY=<your-groq-api-key>
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# To use OpenAI instead, leave OPENAI_BASE_URL unset and use:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
